# Settings for .github/scripts/ai_review.py. Copy this file to .env in the repository root
# (it's git-ignored), pick one model and fill in its key.

# gpt-oss-120b: open weights (Apache 2.0), served by AWS in Frankfurt.
# Through the LiteLLM proxy: use the name LiteLLM lists under /v1/models.
AI_REVIEW_MODEL=openai-chat:<litellm name for gpt-oss-120b>
OPENAI_BASE_URL=https://<your-litellm-host>/v1
OPENAI_API_KEY=

# Or straight from Amazon Bedrock with a Bedrock API key
# AI_REVIEW_MODEL=bedrock:openai.gpt-oss-120b-1:0
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_REGION=eu-central-1

# Or Claude with your own key from console.anthropic.com (a claude.ai login doesn't work here)
# AI_REVIEW_MODEL=anthropic:claude-haiku-5-5
# ANTHROPIC_API_KEY=

# Optional: reasoning effort (low, medium, high); default low. Leave empty if the endpoint rejects it.
# AI_REVIEW_THINKING=low

# Optional: how the verdict comes back: tool (default), native (JSON schema output) or prompted
# AI_REVIEW_OUTPUT=tool
